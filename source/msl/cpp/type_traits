// Logical operator traits
// ^^^^^^

template <class...>
struct conjunction : true_type {};

template <class B1>
struct conjunction<B1> : B1 {};

template <class B1, class... Bn>
struct conjunction<B1, Bn...> : conditional_t<bool(B1::value), conjunction<Bn...>, B1> {};

template <class...>
struct disjunction : false_type {};

template <class B1>
struct disjunction<B1> : B1 {};

template <class B1, class... Bn>
struct disjunction<B1, Bn...> : conditional_t<bool(B1::value), B1, disjunction<Bn...>> {};

template <class B>
struct negation : bool_constant<!static_cast<bool>(B::value)> {};

// Invoke method
// ^^^^^^

template <class T>
class reference_wrapper;

namespace __::type_traits {

template <class>
static constexpr bool is_reference_wrapper_v = false;
template <class U>
static constexpr bool is_reference_wrapper_v<reference_wrapper<U>> = true;

template <class T>
static constexpr T&& forward(
    remove_reference_t<T>& t
) noexcept {
    return static_cast<T&&>(t);
}

template <class T>
static constexpr T&& forward(
    remove_reference_t<T>&& t
) noexcept {
    return static_cast<T&&>(t);
}

template <typename T>
add_rvalue_reference_t<T> declval() noexcept {
    static_assert(false, "declval not allowed in an evaluated context");
}

template <class C, class Pointed, class Object, class... Args>
static constexpr decltype(auto) invoke_memptr(
    Pointed C::* member, Object&& object, Args&&... args
) {
    constexpr bool is_member_function = is_function_v<Pointed>;
    constexpr bool is_wrapped         = is_reference_wrapper_v<remove_cvref_t<Object>>;
    constexpr bool is_derived_object =
        is_same_v<C, remove_cvref_t<Object>> || is_base_of_v<C, remove_cvref_t<Object>>;

    if constexpr (is_member_function) {
        if constexpr (is_derived_object) {
            return (forward<Object>(object).*member)(__::type_traits::forward<Args>(args)...);
        } else if constexpr (is_wrapped) {
            return (object.get().*member)(__::type_traits::forward<Args>(args)...);
        } else {
            return ((*__::type_traits::forward<Object>(object)).*member)(
                __::type_traits::forward<Args>(args)...
            );
        }
    } else {
        static_assert(is_object_v<Pointed> && sizeof...(args) == 0);
        if constexpr (is_derived_object) {
            return __::type_traits::forward<Object>(object).*member;
        } else if constexpr (is_wrapped) {
            return object.get().*member;
        } else {
            return (*__::type_traits::forward<Object>(object)).*member;
        }
    }
}

template <class F, class... Args>
constexpr decltype(auto) invoke(
    F&& f, Args&&... args
) {
    if constexpr (is_member_pointer_v<remove_cvref_t<F>>) {
        return __::type_traits::invoke_memptr(f, forward<Args>(args)...);
    } else {
        return __::type_traits::forward<F>(f)(forward<Args>(args)...);
    }
}

struct empty {};

template <class Fn, class... Args>
concept is_invocable =
    requires(Fn fn, Args&&... args) { __::type_traits::invoke(fn, static_cast<Args&&>(args)...); };

template <class R, class Fn, class... Args>
concept is_invocable_r = requires(Fn fn, Args&&... args) {
    __::type_traits::invoke(fn, static_cast<Args&&>(args)...);
    requires is_convertible_v<
        decltype(__::type_traits::invoke(fn, static_cast<Args&&>(args)...)), R>;
};

template <class Fn, class... Args>
concept is_nothrow_invocable = requires(Fn fn, Args&&... args) {
    __::type_traits::invoke(fn, static_cast<Args&&>(args)...);
    requires noexcept(__::type_traits::invoke(fn, static_cast<Args&&>(args)...));
};

template <class R, class Fn, class... Args>
concept is_nothrow_invocable_r = requires(Fn fn, Args&&... args) {
    invoke(fn, static_cast<Args&&>(args)...);
    requires noexcept(__::type_traits::invoke(fn, static_cast<Args&&>(args)...));
    requires is_convertible_v<
        decltype(__::type_traits::invoke(fn, static_cast<Args&&>(args)...)), R>;
};

} // namespace __::type_traits

template <class Fn, class... Args>
struct is_invocable : integral_constant<bool, __::type_traits::is_invocable<Fn, Args...>> {};
template <class Fn, class... Args>
constexpr bool is_invocable_v = is_invocable<Fn, Args...>::value;

template <class R, class Fn, class... Args>
struct is_invocable_r : integral_constant<bool, __::type_traits::is_invocable_r<R, Fn, Args...>> {};
template <class R, class Fn, class... Args>
constexpr bool is_invocable_r_v = is_invocable_r<R, Fn, Args...>::value;

template <class Fn, class... Args>
struct is_nothrow_invocable
    : integral_constant<bool, __::type_traits::is_nothrow_invocable<Fn, Args...>> {};
template <class Fn, class... Args>
constexpr bool is_nothrow_invocable_v = is_nothrow_invocable<Fn, Args...>::value;

template <class R, class Fn, class... Args>
struct is_nothrow_invocable_r
    : integral_constant<bool, __::type_traits::is_nothrow_invocable_r<R, Fn, Args...>> {};
template <class R, class Fn, class... Args>
constexpr bool is_nothrow_invocable_r_v = is_nothrow_invocable_r<R, Fn, Args...>::value;

template <class Fn, class... Args>
struct invoke_result : conditional_t<
                           !is_invocable_v<Fn, Args...>, __::type_traits::empty,
                           type_identity<decltype(__::type_traits::invoke(
                               __::type_traits::declval<Fn>(), __::type_traits::declval<Args>()...
                           ))>> {};
template <class Fn, class... Args>
using invoke_result_t = invoke_result<Fn, Args...>::type;

