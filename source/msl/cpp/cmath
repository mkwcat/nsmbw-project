constexpr double modf(
    double value, double* iptr
) {
    /* @(#)s_modf.c 1.3 95/01/18 */
    /*
     * ====================================================
     * Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
     *
     * Developed at SunSoft, a Sun Microsystems, Inc. business.
     * Permission to use, copy, modify, and distribute this
     * software is freely granted, provided that this notice
     * is preserved.
     * ====================================================
     */
    const double    x   = value;
    const long long xi  = __builtin_bit_cast(long long, x);
    const int       exp = ((xi >> 52) & 0x7ff) - 0x3ff; /* exponent of x */
    const double    mpz = xi < 0.0 ? -0.0 : 0.0;

    if (exp > 51) {
        // No fraction part
        *iptr = x * 1.0;
        return mpz;
    }
    if (exp < 0) { // |x|<1
        *iptr = mpz;
        return x;
    }

    unsigned long long i = -1ull >> (12 + exp);
    if ((xi & i) == 0) {
        // X is integral
        *iptr = x;
        return mpz;
    }

    *iptr = __builtin_bit_cast(double, xi & ~static_cast<long long>(i));
    return x - *iptr;
}

constexpr float modff(
    float value, float* iptr
) {
    float  frac;
    double intg;

    frac  = modf(value, &intg);
    *iptr = intg;

    return frac;
}

