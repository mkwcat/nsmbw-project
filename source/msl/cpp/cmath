constexpr double lerp(
    double a, double b, double t
) noexcept {
    if (t <= 0.0f) {
        return a;
    }
    if (t >= 1.0f) {
        return b;
    }
    return a + t * (b - a);
}

constexpr float lerp(
    float a, float b, float t
) noexcept {
    if (t <= 0.0f) {
        return a;
    }
    if (t >= 1.0f) {
        return b;
    }
    return a + t * (b - a);
}

constexpr long double lerp(
    long double a, long double b, long double t
) noexcept {
    if (t <= 0.0f) {
        return a;
    }
    if (t >= 1.0f) {
        return b;
    }
    return a + t * (b - a);
}

