{
    "print_base_creation": false,     // Log base creation and deletion to OSReport
    "print_state_changes": false,     // Log all state changes to OSReport
    "end_battles_immediately": false, // End all boss battles immediately after starting
    // Force all 8 sub-players to be present on the world map, regardless of player count
    "force_all_wm_subplayers_present": false,
    // One player can trigger a special ground pound
    "one_player_special_hip_attack_quake": false,

    // Configure a test scenario for the game to boot into;
    // either "world" and "stage", "staffroll", "movie", "title_demo", or "hint_movie_demo"
    // must be set for autoboot to be enabled
    "autoboot": {
        "world": null,           // World number
        "stage": null,           // Stage number (or string e.g. "castle")
        "area": 1,               // Area number
        "entrance": 0,           // Entrance number
        "num_players": 1,        // Number of players
        "player_index": 0,       // First player number
        // Character per each player
        "player_type_order": [
            "mario",
            "luigi",
            "yellow_toad",
            "blue_toad",
            "toadette",
            "purple_toadette",
            "orange_toad",
            "black_toad"
        ],
        // Powerup state; one of: "small", "mushroom", "fire", "mini", "propeller", "penguin", "ice"
        "player_mode": "small",
        "in_star": false,        // Start all players with Star power
        "on_yoshi": false,       // Start all players on Yoshi
        "staffroll": false,      // Play the staff roll
        "movie": null,           // Play a specific movie number
        "title_demo": null,      // Play all title screen demos starting at this number
        "hint_movie_demo": null  // Play all hint movies starting at this number
    }
}
